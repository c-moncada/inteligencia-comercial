{
  "name": "inteligencia-comercial-mvp",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:api": "npm --workspace apps/api run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:ml": "node scripts/ml.mjs serve",
    "build": "npm run build --workspaces",
    "build:web": "npm run build --prefix apps/web",
    "test": "npm --workspace apps/api test && npm run test:ml",
    "test:api": "npm --workspace apps/api test",
    "test:ml": "node scripts/ml.mjs test"
  }
}
